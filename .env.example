# VarshaPurvanumanAI Environment Configuration
# Backend configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_ENV=production
DATA_STATUS=HISTORICAL_BENCHMARK

# CORS allowed origins (comma-separated list for backend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend configuration (frontend/.env)
# Google Maps API key (optional: if omitted, map automatically renders OpenStreetMap/CartoDB tiles)
VITE_GOOGLE_MAPS_API_KEY=

# Backend API base URL for frontend (leave blank for local Vite proxy, or set URL for decoupled production deployment)
VITE_API_BASE_URL=
